# Copiá este archivo a .env y completá los valores.
# fmdc/.env está gitignoreado (raíz + local) — token y PII NUNCA se commitean ni suben upstream.

# ---------- LemonSuite (TimeBillingX v3) ----------
# Tenant = parte antes de .timebillingapp.com
# Ej: https://fmdc.timebillingapp.com  →  LEMONSUITE_TENANT=fmdc
LEMONSUITE_TENANT=
# Access token (Ajustes del sistema > Tokens de acceso; se copia una sola vez)
LEMONSUITE_TOKEN=

# ---------- Plane (self-hosted) — worklog ----------
# Apagado por defecto. Poné true SOLO cuando quieras que el avance se registre en Plane.
PLANE_ENABLED=false
# URL base de tu instancia self-hosted (sin /api). Ej: https://plane.tudominio.com
PLANE_BASE_URL=
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
# UUID del proyecto (NO el identifier/prefijo). Resolvelo con list_projects().
PLANE_PROJECT_ID=
# UUID del ciclo donde se agrupan los work-items de la migración.
PLANE_CYCLE_ID=
# (opcional) id del estado "Done" para cerrar los work-items al completar un paso.
PLANE_DONE_STATE_ID=
